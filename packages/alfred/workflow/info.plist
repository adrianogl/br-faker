				<string># Alfred runs with a minimal PATH, so Node has to be located explicitly.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$HOME/.local/bin:$PATH"

if ! command -v node &gt;/dev/null 2&gt;&amp;1; then
  # Fall back to the newest nvm-managed Node, sorting by version rather than
  # lexicographically so v20 wins over v9.
  nvm_bin=$(ls -d "$HOME"/.nvm/versions/node/*/bin 2&gt;/dev/null | sort -V | tail -1)
  [ -n "$nvm_bin" ] &amp;&amp; export PATH="$nvm_bin:$PATH"
fi

if ! command -v node &gt;/dev/null 2&gt;&amp;1; then
  printf '{"items":[{"uid":"no-node","title":"Node.js not found","subtitle":"Install Node 20+ or add it to PATH in the workflow script","valid":false}]}'
  exit 0
fi

exec node br-faker.cjs "$1"</string>
