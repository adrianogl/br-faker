{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Bundler rather than NodeNext: the .d.ts files shipped by
    // @brazilian-utils/brazilian-utils re-export through extensionless relative
    // paths, which NodeNext rejects for an ESM package. tsup does the bundling,
    // so Bundler matches what actually runs.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"]
}
