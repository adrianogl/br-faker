{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Bundler rather than NodeNext: the .d.ts files shipped by
    // @brazilian-utils/brazilian-utils re-export through extensionless relative
    // paths, which NodeNext rejects for an ESM package. tsup does the bundling,
    // so Bundler matches what actually runs.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "chrome"],
    "baseUrl": ".",
    // The workspace link resolves @br-faker/core to TypeScript source. Mapping
    // it explicitly keeps tsc, vitest and tsup agreeing on one path.
    "paths": {
      "@br-faker/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/*.ts", "scripts"]
}
